---
import { getImage } from "astro:assets";
import Header from "../components/Header.astro";
import waterfall from "../images/waterfall.jpg";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { fade } from "astro:transitions";

const pageName = "yoga";

const optimizedBackground = await getImage({
	format: "webp",
	quality: 80,
	src: waterfall,
	width: 1920
});
---

<Layout>
   <Header currentPage={pageName} />
   <section transition:animate={fade({ duration: "0.4s" })} class="hero" style={`background-image: url('${optimizedBackground.src}')`}/>
   <div class="container" style="margin-top: 20px; max-width: 500px;" transition:animate={fade({ duration: "0.4s" })}>  
		<div>
			<h1 class="title">Tom Mastromonaco</h1>
			<p style="text-align: center;"><b>200 Hour Registered Yoga Teacher</b></p>
         <p style="text-align: center;"> Experience freedom through movement 
            and create alignment in your body and mind through the practice of Yoga </p>
		</div>
   </div>
   <section style="display: flex; flex-direction: row; justify-content: center; padding-bottom: 50px;"> 
      <div style="max-width: 500px;"> 
         <h2>About me</h2>
         <p>
            I am a 200 hour certified Yoga Teacher and I bring over 10 years of personal yoga 
            experience to my teaching. I completed the Enriched Yoga Teacher Training program at 
            the Vancouver School of Healing Arts in 2026 where I received diverse trainings from 
            amazing teachers in hatha, vinyasa flow, and restorative yoga styles. 
         </p>
         <p>
            I focus on offering Hatha Vinyasa Yoga practices with an emphasis on linking movement 
            with breath, alignment, and providing variations to support students where they are at 
            in their own individual practice. My goal in sharing these teachings is to empower 
            students to tune in to their individual bodies and experience the freedom of movement 
            as well as cultivating alignment between the body and the mind. 
         </p>
         <p>
           Yoga became a big part of my life after feeling the adverse effects of sitting and working 
           full-time at a desk. Practicing Yoga helps me move freely and continue to enjoy riding 
           bikes, skiing, and playing soccer. 
         </p>
      </section>
   </div>
</Layout>

<style> 

.hero {
  background-size: cover;
  background-position: center center;
  min-block-size: 30vh;
  place-content: center;
  text-align: center;
  resize: both;
}
</style>
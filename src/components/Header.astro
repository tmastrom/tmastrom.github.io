---
import "../styles/global.css";
import ThemeToggle from "./ThemeToggle.astro";

const { currentPage } = Astro.props;

const headerMap = [
	{
		pageName: "home",
		route: "/",
		title: "Home"
	},
	{
		pageName: "software",
		route: "/software",
		title: "Software"
	},
	{
		pageName: "yoga",
		route: "/yoga",
		title: "Yoga"
	}
];
---

<div id="header" class="container header">
    <div style="display: flex;
		flex-direction: row;
		justify-content: space-between;">
		<div style="display: flex;
		flex-direction: row;
		justify-content: space-between;">
        {headerMap.map((data) => 
            <a class="header-link"
                href={data.route}
                style={data.pageName === currentPage ? "text-decoration: underline;": "" }>
                {data.title}
            </a>
        )}
		</div>
		<div class="header-link">
			<ThemeToggle/>
		</div>
    </div>

</div>

<style>

.header {
	  flex-grow: 0;
  flex-shrink: 0;
}

</style>


